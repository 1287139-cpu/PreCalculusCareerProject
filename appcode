        st.warning("**Interpretation Prompt:** Why is $s = 0$ excluded from the domain, and what happens to average cost near $s = 0$?")

    elif level_choice == "Applied":
        st.markdown("#### Applied: Composing Demand, Capacity, Revenue & Cost Functions")
        b_slope = D0 / p0 if p0 > 0 else 0
        p_break = p0 * (2.0 - cap / D0) if D0 > 0 else 0
        st.write(
            f"**Equations:** $q(p) = \\max(0, {2*D0} - {b_slope:.4f}p)$ on $0 \\le p \\le {2*p0:.0f}$ | "
            f"$s(p) = \\min({cap}, q(p))$ | $R(p) = p \\cdot s(p)$ | $C(s(p)) = {F:.0f} + {v:.2f}s(p)$\n\n"
            f"**Capacity Breakpoint Price:** $p = {p0:.0f}(2 - {cap}/{D0}) = \\${p_break:.2f}$ (below this price, seat capacity caps sales at {cap})."
        )
        p_grid = np.linspace(0, 2 * p0, 61)
        q_grid = np.maximum(0.0, 2 * D0 - b_slope * p_grid)
        s_cont = np.minimum(float(cap), q_grid)
        s_int = np.floor(s_cont)
        prof_cont = p_grid * s_cont - (F + v * s_cont)
        prof_int = p_grid * s_int - (F + v * s_int)

        fig = go.Figure()
        fig.add_trace(go.Scatter(x=p_grid, y=prof_cont, mode="lines", name="Continuous Profit Model ($)"))
        fig.add_trace(go.Scatter(x=p_grid, y=prof_int, mode="lines", line=dict(dash="dot"), name="Integer-Seat Profit ($)"))
        fig.add_hline(y=0, line_dash="dash", annotation_text="Break-Even Zero Line")
        fig.add_vline(x=p_break, line_dash="dashdot", annotation_text=f"Capacity Breakpoint (${p_break:.2f})")
        fig.update_layout(
            title=f"Composed Profit P(p) with Capacity Cap ({cap} seats) | Snapshot {state['snapshot_id']}",
            xaxis_title="Seat Price p ($)",
            yaxis_title="Monthly Operating Profit ($)",
        )
        st.plotly_chart(fig, use_container_width=True)

        df_a = pd.DataFrame(
            {
                "Price p ($)": np.round(p_grid[::5], 2),
                "Unconstrained Demand q(p)": np.round(q_grid[::5], 2),
                "Continuous Seats s(p)": np.round(s_cont[::5], 2),
                "Rounded Integer Seats": s_int[::5].astype(int),
                "Continuous Profit ($)": np.round(prof_cont[::5], 2),
                "Integer Profit ($)": np.round(prof_int[::5], 2),
            }
        )
        st.dataframe(df_a, use_container_width=True, hide_index=True)
        st.download_button("Export Applied Table (CSV)", df_a.to_csv(index=False), "psy2_applied_composition.csv", "text/csv")
        st.warning(
            "**Interpretation Prompt:** Why does the profit formula change slope at the capacity breakpoint price, and how do whole-seat transactions differ from the smooth curve?"
        )

    else:
        st.markdown("#### Advanced: Seasonal Demand Wave $D(t) = D_0\\left(1 + 0.20\\sin\\left(\\frac{2\\pi(t-1)}{12}\\right)\\right)$")
        st.write(
            f"**Assumed Seasonal Model (12-Month Period):** Peaks in Month $t = 4$ at $1.20 \\times {D0} = {1.2*D0:.1f}$ seats "
            f"and hits its low in Month $t = 10$ at $0.80 \\times {D0} = {0.8*D0:.1f}$ seats. Realized sales clip at your **{cap}-seat** limit."
        )
        months = np.arange(1, 13)
        d_t = D0 * (1.0 + 0.20 * np.sin(2.0 * np.pi * (months - 1) / 12.0))
        s_t = np.minimum(float(cap), np.floor(d_t))
        unserved_t = np.maximum(0.0, np.floor(d_t) - s_t)
        prof_t = s_t * p0 - (F + v * s_t)

        fig = go.Figure()
        fig.add_trace(go.Scatter(x=months, y=d_t, mode="lines+markers", name="Seasonal Demand D(t)"))
        fig.add_trace(go.Bar(x=months, y=s_t, name="Realized Seats Sold (Capped)", opacity=0.6))
        fig.add_hline(y=cap, line_dash="dash", annotation_text=f"Seat Capacity Limit ({cap})")
        fig.update_layout(
            title=f"12-Month Seasonal Demand vs. Realized Sales | Snapshot {state['snapshot_id']}",
            xaxis_title="Month Index t (1 to 12)",
            yaxis_title="Program Seats",
        )
        st.plotly_chart(fig, use_container_width=True)

        df_adv = pd.DataFrame(
            {
                "Month (t)": months,
                "Seasonal Demand D(t)": np.round(d_t, 2),
                "Floored Demand": np.floor(d_t).astype(int),
                "Realized Sold (Capped)": s_t.astype(int),
                "Unserved Demand": unserved_t.astype(int),
                "Monthly Operating Profit ($)": np.round(prof_t, 2),
            }
        )
        st.dataframe(df_adv, use_container_width=True, hide_index=True)
        st.download_button("Export Advanced Seasonal Table (CSV)", df_adv.to_csv(index=False), "psy2_advanced_seasonal.csv", "text/csv")
        st.warning(
            "**Extrapolation & Model Limitation:** This seasonal wave is a teaching assumption for 12 months. "
            "Because capacity caps sales at 50 seats in every month, even the Month 10 trough (56 requested) still fills all 50 seats unless capacity drops."
