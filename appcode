# ---------------------------------------------------------------------------
# Core Deterministic Simulation Engine
# ---------------------------------------------------------------------------
def compute_normal_capacity(staff_hours: float, hours_per_unit: float, program_seats: int) -> int:
    if hours_per_unit <= 0:
        return 0
    staff_cap = math.floor(staff_hours / hours_per_unit)
    return max(0, min(staff_cap, int(program_seats)))


def run_simulation_step(
    state: dict,
    run_id: str,
    sim_date: str,
    requested: int,
    capacity_override: int | None = None,
    ad_cost_override: float | None = None,
    mode_label: str = "Normal Mode",
) -> tuple[bool, str]:
    if not run_id or not run_id.strip():
        return False, "Error: A unique run_id is required before running a step."
    if run_id in state["processed_run_ids"]:
        return False, f"Rejected duplicate run_id '{run_id}'. No new transactions were created."

    inp = state["inputs"]
    price = to_dec(inp["base_price"])
    var_unit = sum(to_dec(v) for v in state["variable_costs"].values())
    fixed_total = sum(to_dec(v) for v in state["fixed_costs"].values())

    if capacity_override is not None:
        capacity = max(0, int(capacity_override))
    else:
        capacity = compute_normal_capacity(inp["staff_hours"], inp["hours_per_unit"], inp["program_seats"])

    req_int = max(0, int(requested))
    sold = min(req_int, capacity)
    unserved = max(0, req_int - sold)
    completed = math.floor(sold * float(inp["completion_rate"]))

    marketing = to_dec(ad_cost_override if ad_cost_override is not None else inp["own_marketing_cost"])
    refunds = to_dec(inp["refund_amount"])
    interest = to_dec(inp["interest_expense"])
    principal = to_dec(inp["loan_principal"])
    capex = to_dec(inp["additional_capex"])
    new_owner = to_dec(inp["new_owner_cash"])
    new_loan = to_dec(inp["new_loan_cash"])

    gross_revenue = price * Decimal(sold)
    net_revenue = gross_revenue - refunds
    variable_expense = var_unit * Decimal(sold)
    total_operating_expense = variable_expense + fixed_total + marketing
    operating_profit = net_revenue - total_operating_expense
    net_profit = operating_profit - interest

    opening_cash = to_dec(state["cash_balance"])
    ending_cash = (
        opening_cash
        + net_revenue
        - variable_expense
        - fixed_total
        - marketing
        - interest
        - principal
        - capex
        + new_owner
        + new_loan
    )

    new_version = state["state_version"] + 1
    entry = {
        "run_id": run_id,
        "state_version": new_version,
        "date": sim_date,
        "mode": mode_label,
        "requested": req_int,
        "capacity": capacity,
        "sold": sold,
        "unserved_demand": unserved,
        "completed_students": completed,
        "satisfaction_mean": float(inp["satisfaction_mean"]),
        "unit_price": float(price),
        "revenue": float(net_revenue),
        "variable_expense": float(variable_expense),
        "fixed_expense": float(fixed_total),
        "marketing_expense": float(marketing),
        "total_expense": float(total_operating_expense),
        "operating_profit": float(operating_profit),
        "interest_expense": float(interest),
        "net_profit": float(net_profit),
        "opening_cash": float(opening_cash),
        "ending_cash": float(ending_cash),
    }

    state["ledger"].append(entry)
    state["processed_run_ids"].append(run_id)
    state["cash_balance"] = f"{ending_cash:.2f}"
    state["debt_balance"] = f"{(to_dec(state['debt_balance']) + new_loan - principal):.2f}"
    state["state_version"] = new_version
    state["simulation_date"] = sim_date
    state["snapshot_id"] = f"SNAP-{new_version:03d}"

    return True, f"Recorded run '{run_id}' (State v{new_version}). Closing cash: {fmt_money(ending_cash)}."


# ---------------------------------------------------------------------------
# Snapshot Export & Import Validation
# ---------------------------------------------------------------------------
def build_snapshot_json(state: dict) -> str:
    payload = {
        "exported_at_utc": datetime.now(timezone.utc).isoformat(),
        **state,
    }
    return json.dumps(payload, indent=2)


def validate_and_import_snapshot(raw_text: str, current_state: dict) -> tuple[bool, str, dict | None]:
    try:
        incoming = json.loads(raw_text)
    except json.JSONDecodeError as exc:
        return False, f"Invalid JSON file: {exc}", None

    required_keys = ["team_id", "course", "pathway_id", "state_version", "cash_balance", "inputs", "ledger"]
    for key in required_keys:
        if key not in incoming:
            return False, f"Rejected import: missing required field '{key}'.", None

    if incoming["team_id"] != current_state["team_id"]:
        return (
            False,
            f"Rejected import: team_id '{incoming['team_id']}' does not match active team '{current_state['team_id']}'.",
            None,
        )

    if int(incoming["state_version"]) < int(current_state["state_version"]):
        return (
            False,
            f"Rejected stale snapshot: incoming version v{incoming['state_version']} is older than current v{current_state['state_version']}.",
            None,
        )

    if to_dec(incoming["cash_balance"]) < 0:
        return False, "Rejected import: negative cash balance is not permitted.", None

    return True, f"Imported snapshot '{incoming.get('snapshot_id', 'N/A')}' at state v{incoming['state_version']}.", incoming


